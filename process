15. Minimal end-to-end code skeleton

(This is a compact runnable skeleton — adapt features and hyperparams.)

# src/features.py
import pandas as pd
import ta

def make_features(df):
    df['return1'] = df['Close'].pct_change()
    df['ema12'] = ta.trend.ema_indicator(df['Close'], window=12)
    df['ema26'] = ta.trend.ema_indicator(df['Close'], window=26)
    df['rsi14'] = ta.momentum.rsi(df['Close'], window=14)
    df['atr14'] = ta.volatility.average_true_range(df['High'], df['Low'], df['Close'], window=14)
    df['bb_pct'] = (df['Close'] - ta.volatility.bollinger_mavg(df['Close'], window=20)) / (ta.volatility.bollinger_hband(df['Close']) - ta.volatility.bollinger_lband(df['Close']))
    df = df.dropna()
    return df

# src/label.py
def label_future(df, H=6, T=0.003):
    df['future'] = df['Close'].shift(-H)
    df['fret'] = df['future'] / df['Close'] - 1
    df['label'] = 0
    df.loc[df['fret'] >= T, 'label'] = 1
    df.loc[df['fret'] <= -T, 'label'] = -1
    df = df.dropna()
    return df

# src/train.py
from xgboost import XGBClassifier
from sklearn.metrics import classification_report
def train_model(df, features):
    train_split = int(len(df)*0.7)
    X_train = df[features].iloc[:train_split]
    y_train = df['label'].iloc[:train_split]
    X_test = df[features].iloc[train_split:]
    y_test = df['label'].iloc[train_split:]
    model = XGBClassifier(n_estimators=400, max_depth=5, learning_rate=0.03)
    model.fit(X_train, y_train)
    print(classification_report(y_test, model.predict(X_test)))
    return model

